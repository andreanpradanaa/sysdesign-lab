---
import Base from '../layouts/Base.astro';

// Angka latency: orde besaran versi 2020-an (rujukan: "Latency Numbers Every Programmer Should Know", System Design Primer).
const latency = [
  ['L1 cache reference', '~1 ns', 'Hampir gratis'],
  ['Branch mispredict', '~3 ns', ''],
  ['L2 cache reference', '~4 ns', ''],
  ['Mutex lock/unlock', '~17 ns', ''],
  ['Main memory reference', '~100 ns', 'RAM 100x lebih lambat dari L1'],
  ['Compress 1 KB (Snappy)', '~2 µs', ''],
  ['Kirim 2 KB lewat 10 Gbps network', '~2 µs', ''],
  ['Baca 1 MB berurutan dari RAM', '~3 µs', ''],
  ['SSD random read (4 KB)', '~16 µs', ''],
  ['Baca 1 MB berurutan dari SSD', '~50 µs', ''],
  ['Round trip dalam satu datacenter', '~500 µs', '0.5 ms'],
  ['Baca 1 MB berurutan dari HDD', '~1 ms', ''],
  ['HDD seek', '~2 ms', ''],
  [
    'Round trip antar benua (mis. Jakarta → US West)',
    '~150 ms',
    'Tidak bisa dipercepat, hanya dihindari (CDN, edge)',
  ],
];

const powers = [
  ['2^10', '1.024', 'KB (≈ ribu)'],
  ['2^20', '1.048.576', 'MB (≈ juta)'],
  ['2^30', '1.073.741.824', 'GB (≈ miliar)'],
  ['2^40', '≈ 1.1 × 10^12', 'TB (≈ triliun)'],
  ['2^50', '≈ 1.1 × 10^15', 'PB'],
];

const nines = [
  ['99%', '3.65 hari', '7.2 jam'],
  ['99.9%', '8.76 jam', '43.8 menit'],
  ['99.99%', '52.6 menit', '4.38 menit'],
  ['99.999%', '5.26 menit', '26.3 detik'],
];

const patterns = [
  [
    'Baca jauh lebih banyak dari tulis',
    'Cache (read-through / cache-aside) + read replica + CDN untuk aset statis',
  ],
  [
    'Tulis sangat tinggi (log, event, metrik)',
    'Message queue sebagai buffer → batch writer → time-series / column store',
  ],
  ['Hot key / counter global', 'Sharded counter, agregasi periodik, atau approximate (HyperLogLog)'],
  [
    'Fan-out ke banyak penerima (feed, notifikasi)',
    'Fan-out on write untuk user biasa; fan-out on read untuk selebriti (hybrid)',
  ],
  [
    'Kerja berat / lambat di request path',
    'Pindahkan ke worker async lewat queue; kembalikan job id; client polling / push',
  ],
  ['Butuh unik & terurut tanpa koordinasi', 'ID ala Snowflake (timestamp + machine id + sequence)'],
  [
    'Satu data harus konsisten kuat (saldo, stok)',
    'SQL + transaksi + idempotency key; hindari distributed transaction bila bisa',
  ],
  ['Pencarian teks / fuzzy', 'Inverted index (Elasticsearch/OpenSearch), update async dari DB utama (CDC)'],
  ['Lokasi / radius', 'Geohash atau quadtree, diindeks di KV/Redis GEO/PostGIS'],
  ['Batasi abuse / biaya', 'Rate limiter (token bucket) di gateway, state di Redis'],
  ['Melindungi dependency yang sakit', 'Timeout + retry dengan backoff + jitter, circuit breaker, bulkhead'],
  [
    'File besar (video, gambar)',
    'Blob store (S3-like) + metadata di DB + CDN; upload langsung via presigned URL',
  ],
];

const dbChoice = [
  [
    'Transaksi multi-baris, join, skema stabil',
    'PostgreSQL / MySQL',
    'Scale write secara vertikal dulu; sharding belakangan',
  ],
  [
    'Akses by key, latency sangat rendah, TTL',
    'Redis / Memcached (cache), DynamoDB-style KV',
    'Model data harus muat di pola key → value',
  ],
  [
    'Write-heavy, time-series, skala horizontal mudah',
    'Cassandra / ScyllaDB (wide-column)',
    'Query harus didesain dari awal (query-first modeling)',
  ],
  ['Dokumen semi-terstruktur, skema berubah cepat', 'MongoDB / Couchbase', 'Hati-hati join antar koleksi'],
  [
    'Pencarian full-text, agregasi log',
    'Elasticsearch / OpenSearch',
    'Bukan source of truth; index dari DB utama',
  ],
  [
    'Relasi banyak-hop (graf sosial, rekomendasi)',
    'Neo4j / graph DB, atau adjacency di KV',
    'Hanya bila query multi-hop memang dominan',
  ],
  [
    'Analitik kolom, OLAP',
    'ClickHouse / BigQuery / data warehouse',
    'Terpisah dari OLTP, diisi lewat ETL/CDC',
  ],
  ['Objek biner besar', 'S3 / GCS / MinIO (blob store)', 'Simpan metadata-nya di DB'],
];
---

<Base title="Cheat Sheet" width="wide">
  <div class="cheat">
    <span class="eyebrow">Referensi cepat</span>
    <h1>Cheat sheet</h1>
    <p class="muted">
      Angka orde-besaran untuk estimasi cepat, pola yang berulang, dan tabel memilih database. Hafalkan yang
      di tabel pertama.
    </p>

    <h2>Latency numbers</h2>
    <table>
      <thead>
        <tr>
          <th>Operasi</th>
          <th>Waktu</th>
          <th>Catatan</th>
        </tr>
      </thead>
      <tbody>
        {latency.map((r) => (
          <tr>
            <td>{r[0]}</td>
            <td>
              <code>{r[1]}</code>
            </td>
            <td class="muted">{r[2]}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="small muted">
      Aturan ingat: RAM ≈ 100 ns, SSD ≈ 100 µs, HDD ≈ 10 ms, satu RTT datacenter ≈ 0.5 ms, lintas benua ≈ 150
      ms. Tiap turun satu tingkat ≈ 100-1000x lebih lambat.
    </p>

    <h2>Pangkat dua & satuan</h2>
    <table>
      <thead>
        <tr>
          <th>Pangkat</th>
          <th>Nilai</th>
          <th>Satuan</th>
        </tr>
      </thead>
      <tbody>
        {powers.map((r) => (
          <tr>
            <td>
              <code>{r[0]}</code>
            </td>
            <td>{r[1]}</td>
            <td>{r[2]}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2>Rule of thumb estimasi</h2>
    <ul>
      <li>
        1 hari ≈ 86.400 detik ≈ <strong>10^5</strong> detik (bulatkan). 1 juta request/hari ≈{' '}
        <strong>12 QPS</strong>; 100 juta/hari ≈ 1.200 QPS.
      </li>
      <li>Peak ≈ 2–3x rata-rata. Desain untuk peak, bukan rata-rata.</li>
      <li>Rasio baca:tulis biasanya 10:1 sampai 100:1 untuk aplikasi konsumer.</li>
      <li>
        Ukuran kasar: id/timestamp 8 B, URL ~100 B, tweet ~300 B, foto ~200 KB–2 MB, video 1 menit ~50 MB
        (720p).
      </li>
      <li>
        Satu server modern: puluhan ribu koneksi, ribuan QPS CPU-ringan; DB tunggal: ~ribuan write/s, puluhan
        ribu read/s dengan cache.
      </li>
      <li>Storage 5 tahun = per hari × 365 × 5 ≈ per hari × 2.000 (bulatkan).</li>
    </ul>

    <h2>Availability ("nines")</h2>
    <table>
      <thead>
        <tr>
          <th>SLA</th>
          <th>Downtime / tahun</th>
          <th>Downtime / bulan</th>
        </tr>
      </thead>
      <tbody>
        {nines.map((r) => (
          <tr>
            <td>
              <strong>{r[0]}</strong>
            </td>
            <td>{r[1]}</td>
            <td>{r[2]}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="small muted">
      Komponen seri: availability dikalikan (99.9% × 99.9% ≈ 99.8%). Paralel/redundan: 1 − (1−a)(1−b) → dua
      komponen 99% paralel ≈ 99.99%.
    </p>

    <h2>Pola umum</h2>
    <table>
      <thead>
        <tr>
          <th>Masalah</th>
          <th>Pola yang biasa dipakai</th>
        </tr>
      </thead>
      <tbody>
        {patterns.map((r) => (
          <tr>
            <td>{r[0]}</td>
            <td>{r[1]}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2>Memilih database</h2>
    <table>
      <thead>
        <tr>
          <th>Kebutuhan dominan</th>
          <th>Pilihan umum</th>
          <th>Catatan</th>
        </tr>
      </thead>
      <tbody>
        {dbChoice.map((r) => (
          <tr>
            <td>{r[0]}</td>
            <td>{r[1]}</td>
            <td class="muted">{r[2]}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2>Urutan menjawab (45 menit)</h2>
    <ol>
      <li>
        <strong>Requirements</strong> (5 mnt): functional (3–5 fitur inti), non-functional (skala, latency,
        konsistensi vs availability), out of scope.
      </li>
      <li>
        <strong>Estimasi</strong> (4 mnt): QPS baca/tulis, storage, bandwidth, cache size (aturan 80/20).
      </li>
      <li>
        <strong>API</strong> (4 mnt): endpoint utama, parameter, idempotency.
      </li>
      <li>
        <strong>Skema data</strong> (4 mnt): entitas, kunci akses, pilihan DB dan alasannya.
      </li>
      <li>
        <strong>High-level design</strong> (10 mnt): gambar kotak-panah end-to-end, jelaskan satu alur baca
        dan satu alur tulis.
      </li>
      <li>
        <strong>Deep dive</strong> (12 mnt): 2–3 komponen paling kritis, failure mode, trade-off.
      </li>
      <li>
        <strong>Evaluasi</strong> (4 mnt): cek lagi tiap NFR, bottleneck, single point of failure.
      </li>
      <li>
        <strong>Wrap-up</strong> (2 mnt): apa yang akan dilakukan kalau ada waktu lebih.
      </li>
    </ol>
  </div>
</Base>
