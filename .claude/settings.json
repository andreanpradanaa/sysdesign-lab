{
  "permissions": {
    "allow": [
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm check*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm format*)",
      "Bash(pnpm preview*)",
      "Bash(pnpm astro dev*)",
      "Bash(pnpm install*)",
      "Bash(pnpm ls*)",
      "Bash(pnpm why*)",
      "Bash(graphify *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "Bash(wc *)",
      "Bash(node --version)",
      "Bash(pnpm --version)"
    ],
    "deny": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-git-commit.sh" }
        ]
      }
    ]
  }
}
